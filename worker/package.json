{
  "name": "reminder-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker & D1 Web Push Backend for reminderme",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create reminder-db",
    "d1:init:local": "wrangler d1 execute reminder-db --local --file=./schema.sql",
    "d1:init:remote": "wrangler d1 execute reminder-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240405.0",
    "typescript": "^5.4.0",
    "wrangler": "^3.50.0"
  }
}
