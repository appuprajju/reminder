{
  "name": "reminderme",
  "version": "3.0.0",
  "description": "reminderme — Native-grade Android & PWA daily reminders, exact alarms, voice capture, calendar schedule, and offline-first sync.",
  "private": true,
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "start": "node server.js",
    "icons": "node scripts/make-icons.js",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "android:aab": "npm run build && npx cap sync android && cd android && ./gradlew bundleRelease",
    "test": "sh scripts/verify-server.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "web-push": "^3.6.7"
  }
}
