{
  "name": "reminderme — Smart Alarms & Daily Reminders",
  "short_name": "reminderme",
  "description": "Native-grade daily reminders, loud exact alarms, voice capture, calendar schedule, and offline-first sync.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#060812",
  "theme_color": "#060812",
  "categories": ["productivity", "utilities", "lifestyle"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/?action=share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text"
    }
  },
  "shortcuts": [
    {
      "name": "Voice Reminder",
      "short_name": "Voice",
      "description": "Speak to add a new alarm or reminder hands-free",
      "url": "/?action=voice&source=shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "New Alarm",
      "short_name": "New Alarm",
      "description": "Quickly add a new alarm or reminder",
      "url": "/?action=new",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Schedule",
      "short_name": "Schedule",
      "description": "Open your calendar schedule",
      "url": "/?tab=schedule",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
