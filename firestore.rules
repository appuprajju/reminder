rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net — default deny everything not explicitly matched
    match /{document=**} {
      allow read, write: if false;
    }

    // ============ Reusable Hardened Primitives ============
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidOptionalNumber(data, field) {
      return !(field in data) || data[field] == null || data[field] is number;
    }

    function isValidDays(data) {
      return !('days' in data)
        || data.days == null
        || (
          data.days is list
          && data.days.size() <= 7
          && (data.days.size() == 0 || (data.days[0] is int && data.days[0] >= 0 && data.days[0] <= 6))
        );
    }

    function isValidSubtasks(data) {
      return !('subtasks' in data)
        || data.subtasks == null
        || (
          data.subtasks is list
          && data.subtasks.size() <= 25
          && (
            data.subtasks.size() == 0
            || (
              data.subtasks[0] is map
              && data.subtasks[0].keys().hasAll(['id', 'title', 'done'])
              && data.subtasks[0].keys().hasOnly(['id', 'title', 'done'])
              && data.subtasks[0].id is string
              && data.subtasks[0].id.size() <= 64
              && data.subtasks[0].title is string
              && data.subtasks[0].title.size() <= 120
              && data.subtasks[0].done is bool
            )
          )
        );
    }

    // ============ Entity Validation Blueprints ============
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'email', 'tz', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'name', 'email', 'tz', 'timeFormat', 'autoDeleteCompleted', 'vibrate', 'createdAt', 'updatedAt'
        ])
        && data.uid == request.auth.uid
        && data.uid == userId
        && isValidId(data.uid)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.tz is string && data.tz.size() >= 1 && data.tz.size() <= 64
        && (!('timeFormat' in data) || data.timeFormat in ['12h', '24h'])
        && (!('autoDeleteCompleted' in data) || data.autoDeleteCompleted is bool)
        && (!('vibrate' in data) || data.vibrate is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReminder(data, userId, reminderId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'note', 'time', 'dueAt', 'emoji', 'color', 'priority', 'isAlarm', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'note', 'time', 'dueAt', 'days', 'oneTimeDate',
          'emoji', 'color', 'priority', 'tag', 'isAlarm', 'sound', 'doneDate',
          'snoozedUntil', 'subtasks', 'googleCalendarEventId', 'createdAt', 'updatedAt'
        ])
        && data.id == reminderId
        && isValidId(data.id)
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.note is string && data.note.size() <= 400
        && data.time is string && data.time.size() == 5 && data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.dueAt is number
        && isValidDays(data)
        && isValidOptionalString(data, 'oneTimeDate', 10)
        && data.emoji is string && data.emoji.size() >= 1 && data.emoji.size() <= 16
        && data.color is string && data.color.size() >= 4 && data.color.size() <= 24
        && data.priority is string && data.priority in ['high', 'med', 'low']
        && isValidOptionalString(data, 'tag', 32)
        && data.isAlarm is bool
        && isValidOptionalString(data, 'sound', 32)
        && isValidOptionalString(data, 'doneDate', 10)
        && isValidOptionalNumber(data, 'snoozedUntil')
        && isValidSubtasks(data)
        && isValidOptionalString(data, 'googleCalendarEventId', 200)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ============ User Profile (PII Strictly Isolated to Owner) ============
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'email', 'tz', 'timeFormat', 'autoDeleteCompleted', 'vibrate', 'updatedAt'
        ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      // ============ Reminders Subcollection ============
      match /reminders/{reminderId} {
        allow get: if isOwner(userId)
          && isValidId(userId)
          && isValidId(reminderId)
          && existing().ownerId == request.auth.uid;

        allow list: if isOwner(userId)
          && isValidId(userId)
          && existing().ownerId == request.auth.uid;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(reminderId)
          && isValidReminder(incoming(), userId, reminderId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(reminderId)
          && isValidReminder(incoming(), userId, reminderId)
          && existing().ownerId == request.auth.uid
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && (
            // Action 1: Full reminder edit
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'note', 'time', 'dueAt', 'days', 'oneTimeDate', 'emoji', 'color',
              'priority', 'tag', 'isAlarm', 'sound', 'doneDate', 'snoozedUntil',
              'subtasks', 'googleCalendarEventId', 'updatedAt'
            ])
            // Action 2: Quick state toggle (complete, snooze, subtask check, calendar link)
            || incoming().diff(existing()).affectedKeys().hasOnly([
              'doneDate', 'snoozedUntil', 'dueAt', 'subtasks', 'googleCalendarEventId', 'updatedAt'
            ])
          );

        allow delete: if isOwner(userId)
          && isValidId(userId)
          && isValidId(reminderId)
          && existing().ownerId == request.auth.uid;
      }
    }
  }
}
