# ====================================================================
# reminderme - Environment Configuration & Web Push VAPID Credentials
# ====================================================================

# Port for the Node.js server (defaults to 3000)
PORT=3000

# --------------------------------------------------------------------
# Web Push VAPID Keys
# Generate your own unique pair by running this command in your terminal:
#
#   npx web-push generate-vapid-keys
#
# Then paste the generated Public and Private keys below:
# --------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@reminderme.app

# --------------------------------------------------------------------
# Optional Configuration
# --------------------------------------------------------------------
# Secret token to protect the scheduled cron endpoint:
#   POST /api/cron/check-reminders
# Pass via header `Authorization: Bearer <CRON_SECRET>` or query `?key=<CRON_SECRET>`
CRON_SECRET=

# Comma-separated admin emails who have access to /api/admin/analytics
ADMIN_EMAILS=

# Background worker tick interval in milliseconds (defaults to 60000 = 1 minute)
TICK_MS=60000

# Data directory for database storage (defaults to ./data)
DATA_DIR=data
